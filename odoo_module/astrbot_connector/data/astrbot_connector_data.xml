<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- AstrBot Partner (Bot User) -->
        <record id="partner_astrbot" model="res.partner">
            <field name="name">AstrBot</field>
            <field name="is_company">False</field>
            <field name="active">True</field>
            <field name="type">contact</field>
            <field name="email">astrbot@localhost</field>
            <field name="comment">AstrBot AI Assistant - This is an automated bot partner for AI chat integration.</field>
        </record>

        <!-- AstrBot User (Required for Discuss visibility) -->
        <record id="user_astrbot" model="res.users">
            <field name="name">AstrBot</field>
            <field name="login">astrbot</field>
            <field name="partner_id" ref="partner_astrbot"/>
            <field name="active">True</field>
            <!-- No password set - bot cannot login, only used for Discuss -->
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Default configuration parameters -->
        <record id="config_param_enabled" model="ir.config_parameter">
            <field name="key">astrbot_connector.enabled</field>
            <field name="value">False</field>
        </record>

        <record id="config_param_bot_name" model="ir.config_parameter">
            <field name="key">astrbot_connector.bot_name</field>
            <field name="value">AstrBot</field>
        </record>

        <!-- Store bot user reference for quick lookup -->
        <record id="config_param_bot_user_id" model="ir.config_parameter">
            <field name="key">astrbot_connector.bot_user_id</field>
            <field name="value" eval="ref('user_astrbot')"/>
        </record>
    </data>
</odoo>
